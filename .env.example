# Plantilla del entorno de la WEB. Copia a `.env` EN EL SERVIDOR y rellena.
#
# El `.env` real vive SOLO en /root/SOTOdelPRIOR/webs/sotodelprior/ del VPS y
# está fuera de git desde ce0fc3ac. Este repo es PÚBLICO: nunca pongas un valor
# real en este fichero ni en docker-compose.yml.
#
# Los que llevan guard `${VAR:?}` en el compose son obligatorios: si falta uno,
# el stack no arranca, en vez de levantar la web a medias.

# --- Sesiones ----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=__CAMBIA_ESTO__
# Variable heredada de NextAuth v4; la app usa AUTH_SECRET. Se conserva porque
# el compose la sigue pasando.
NEXTAUTH_SECRET=__CAMBIA_ESTO__

# --- Obrador (catálogo y pedidos) --------------------------------------------
# Clave de integración del local. Se genera y se rota desde
# Obrador → Ajustes → Integración; al rotarla, se cambia AQUÍ y se redespliega.
OBRADOR_API_KEY=__CAMBIA_ESTO__

# --- Stripe ------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- URLs --------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://www.sotodelprior.com
